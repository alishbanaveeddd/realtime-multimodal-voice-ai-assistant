# Template for local secrets. Copy to .env and fill in real values.
# .env is gitignored and never pushed; this file is safe to commit.

# --- ASR (Deepgram streaming transcription) ---
DEEPGRAM_API_KEY=

# --- LLM (OpenAI Chat Completions SSE) ---
OPENAI_API_KEY=
# Optional: override the default model (gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# --- TTS (ElevenLabs streamed synthesis) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Optional timeout tuning (seconds) ---
# VOICE_LLM_TIMEOUT_SECONDS=60
# VOICE_TTS_SEND_TIMEOUT_SECONDS=30
# VOICE_TTS_FINISH_TIMEOUT_SECONDS=10
# VOICE_TTS_WAIT_TIMEOUT_SECONDS=60
